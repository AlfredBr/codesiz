{
  "include": [
    "**/*.c",
    "**/*.cc",
    "**/*.cpp",
    "**/*.cs",
    "**/*.css",
    "**/*.fs",
    "**/*.go",
    "**/*.h",
    "**/*.hpp",
    "**/*.html",
    "**/*.java",
    "**/*.js",
    "**/*.jsx",
    "**/*.kt",
    "**/*.ps1",
    "**/*.py",
    "**/*.razor",
    "**/*.rs",
    "**/*.scss",
    "**/*.sh",
    "**/*.swift",
    "**/*.ts",
    "**/*.tsx",
    "**/*.vue"
  ],
  "exclude": [
    ".git/**",
    ".hg/**",
    ".svn/**",
    ".vscode/**",
    ".idea/**",
    "bin/**",
    "**/bin/**",
    "obj/**",
    "**/obj/**",
    "build/**",
    "**/build/**",
    "dist/**",
    "**/dist/**",
    "out/**",
    "**/out/**",
    "target/**",
    "**/target/**",
    "vendor/**",
    "**/vendor/**",
    "node_modules/**",
    "**/node_modules/**",
    "coverage/**",
    "**/coverage/**",
    "**/*.g.cs",
    "**/*.generated.*",
    "**/*.min.css",
    "**/*.min.js",
    "**/*.bin",
    "**/*.dll",
    "**/*.exe",
    "**/*.gif",
    "**/*.jpeg",
    "**/*.jpg",
    "**/*.mov",
    "**/*.o",
    "**/*.obj",
    "**/*.png",
    "**/*.wav"
  ]
}
